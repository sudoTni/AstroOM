# AstroOM Distribution & Development .gitignore

# Cargo build tree
target/

# Runtime mutable state (created on demand)
data/
logs/
materials/
materials-deployed/

# Private candidate profile data (template candidate_data.example is tracked)
candidate_data/
michael_martini_data/

# Environment secrets and credentials
.env
.env.*
!.env.example

# Local SQLite databases and write-ahead logs
*.sqlite
*.sqlite-*
*.db
*.db-*

# Runtime execution and payload logs
*.log

# Shipped test fixtures (explicit exceptions)
!tests/fixtures/*.sqlite
!tests/fixtures/*.sqlite-*

# Distribution binaries in ./bin/
# Distributable release binaries are tracked; intermediate/temporary build files are excluded
bin/*
!bin/astroom
!bin/astroom.exe
!bin/.gitkeep

# Operating system and editor metadata
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
