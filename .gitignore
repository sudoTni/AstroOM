# Rust / Cargo build output
target/
**/*.rs.bk
*.pdb

# Release binaries explicitly tracked
!bin/
!bin/astroom
!bin/astroom.exe
!bin/*

# Local candidate profiles and secrets
.env
.env.*
!.env.example
candidate_data/

# Application runtime directories
data/
logs/
materials/
materials-deployed/

# Database files & journals (keep committed test fixtures)
*.sqlite
*.sqlite-*
