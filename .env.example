# Copy to a private file (astro_launcher.bash sources this). Do not commit real keys.
# These keys are launcher-private configuration; the astroom application reads
# NO environment variables for anything except the two path overrides
# ASTROOM_HOME / ASTROOM_RESOURCE_DIR and the optional Indeed credential below
# - all other configuration flows through explicit CLI flags.
AOM_OR_API_KEY=

# Optional: supply your own Indeed client key instead of the compiled-in public
# one. Leave empty to use the built-in key, which needs no configuration.
# ASTROOM_INDEED_API_KEY=

# Optional explicit directory redirection (forwarded as --data-dir etc.)
# AOM_DATA_DIR=/absolute/path/to/data
# AOM_LOG_DIR=/absolute/path/to/logs
# AOM_MATERIALS_DIR=/absolute/path/to/materials
# AOM_PROFILE_DIR=/absolute/path/to/profile

# Optional launcher behavior (forwarded as --clean / --deploy flags)
# AOM_CLEAN=1
# AOM_DEPLOY=1
# AOM_DEPLOY_DESTINATION="GoogleDrive:/autoJobGen-src"
